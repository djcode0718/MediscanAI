# ==============================================================================
# MediScanAI Production Environment Configuration Template
# Target: Oracle Cloud Always Free (Ampere A1 ARM64)
# Copy this file to deployment/.env and set your secrets before deploying.
# ==============================================================================

# Application Meta
APP_NAME=MediScanAI
APP_ENV=production
DEBUG=false

# Production Container Image (Managed by deployment/scripts/deploy.sh & CI/CD)
# Set to immutable GHCR reference (e.g. ghcr.io/<owner>/mediscanai-backend:sha-abc1234)
# Defaults to mediscanai-backend:production if unset.
MEDISCANAI_IMAGE=mediscanai-backend:production

# Domain & Reverse Proxy Configuration
# Set to your fully-qualified domain name (e.g. mediscan.yourdomain.com) for automatic HTTPS
# Leave as :80 for direct IP access or testing
DOMAIN_NAME=:80

# PostgreSQL Database Configuration
POSTGRES_USER=mediscanai
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_RANDOM_PASSWORD_32_CHARS
POSTGRES_DB=mediscanai

# JWT Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Mode Configuration
# Strictly 'online' for cloud deployment (₹0 compute budget, uses Gemini / Groq fallback)
LLM_MODE=online
ONLINE_LLM_TIMEOUT_SECONDS=60.0

# Online LLM API Keys (At least one provider required for online mode)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Primary & Fallback Models
GEMINI_MODEL_1=gemini-3.6-flash
GEMINI_MODEL_2=gemini-3.7-flash
GROQ_MODEL_1=openai/gpt-oss-120b
GROQ_MODEL_2=openai/gpt-oss-20b

# CORS Configuration
# JSON list of allowed origins. Wildcard '*' is strictly prohibited in production.
# NOTE: 'localhost' and '127.0.0.1' origins are appropriate ONLY for local development, NOT for a public production allowlist.
# For production HTTPS deployment, specify ONLY your deployed frontend domains:
CORS_ORIGINS=["https://app.yourdomain.com", "https://yourdomain.com"]

# Concurrency & Resource Throttling
MAX_CONCURRENT_ANALYSES=2
RATE_LIMIT_ANALYZE_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=20

# Clinical Safety Guardrail
# Must be enabled in production to detect acute emergency symptoms (stroke, MI, anaphylaxis)
EMERGENCY_GUARDRAIL_ENABLED=true
EMERGENCY_GUARDRAIL_FAST_PATH=true
EMERGENCY_GUARDRAIL_CONFIG_PATH=app/guardrail_config.json

