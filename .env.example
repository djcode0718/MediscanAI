# ==============================================================================
# MediScanAI Environment Configuration Template (.env.example)
# ==============================================================================

# Application Meta
APP_NAME=MediScanAI
APP_ENV=development
DEBUG=false

# PostgreSQL Database
DATABASE_URL=postgresql+psycopg2://localhost:5432/mediscanai
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# JWT Authentication
# Generate a secure key for production using: openssl rand -hex 32
JWT_SECRET_KEY=YOUR_SECURE_RANDOM_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Upload & Request Bounds Configuration
MAX_IMAGE_SIZE_BYTES=10485760
MAX_AUDIO_SIZE_BYTES=26214400
MAX_TEXT_LENGTH=4000
MAX_AUDIO_CLIPS_COUNT=5

# Rate Limiting Configuration (per minute)
RATE_LIMIT_ANALYZE_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=20

# Concurrency & Resource Protection
MAX_CONCURRENT_ANALYSES=2

# Ollama & Model Service Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MODEL=mistral

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","*"]
