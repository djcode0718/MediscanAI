{
  "spec_version": "1.0.0",
  "phase": "D.2.a",
  "system": "MediScanAI Intent Routing Engine",
  "routing_policy": {
    "default_channel_allocation": "data_driven_priority",
    "preserve_original_query": true,
    "fallback_channel": "multi_channel_rrf",
    "abstention_on_unverified_entity": true,
    "emergency_escalation_protocol": "immediate_red_flag_interception"
  },
  "intents": [
    {
      "intent_id": "emergency_escalation",
      "description": "High-risk, life-threatening symptoms requiring immediate emergency clinical triage rather than ordinary medicine advice.",
      "target_indexes": [],
      "routing_action": "TRIAGE_ESCALATE",
      "candidate_allocation": { "drugs": 0, "diseases": 0, "drug_dict": 0 },
      "priority": 1,
      "examples": [
        "severe chest pain radiating to left arm and shortness of breath",
        "sudden numbness on one side of face and arm weakness",
        "anaphylaxis with throat swelling and difficulty breathing"
      ]
    },
    {
      "intent_id": "unverified_fictional_negative",
      "description": "Fictional, non-existent, or unverified drug entities (e.g., negative controls like Zephastin, Virokine, Pulmoflux, Noxipram) that must not match real pharmaceuticals.",
      "target_indexes": [],
      "routing_action": "CLEAN_ABSTAIN",
      "candidate_allocation": { "drugs": 0, "diseases": 0, "drug_dict": 0 },
